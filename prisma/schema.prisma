generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int        @id @default(autoincrement())
  username      String     @unique
  passwordHash  String
  role          String     @default("employee") // "admin" | "employee"
  vacationDays  Int        @default(22)
  createdAt     DateTime   @default(now())
  vacations     Vacation[]
}

model Booking {
  id            Int      @id @default(autoincrement())
  date          String   // "YYYY-MM-DD"
  time          String   // "HH:MM"
  serviceId     String
  serviceName   String
  customerName  String
  customerPhone String   @default("")
  notes         String   @default("")
  source        String   @default("website") // "website" | "admin"
  createdAt     DateTime @default(now())

  @@index([date])
}

model Vacation {
  id     Int    @id @default(autoincrement())
  userId Int
  date   String // "YYYY-MM-DD"
  status String @default("booked") // "booked" | "used"
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/* ============================== */
/* STORE MODELS                   */
/* ============================== */

model Customer {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id           Int             @id @default(autoincrement())
  title        String
  description  String          @default("")
  price        Float
  available    Boolean         @default(true)
  images       String          @default("[]") // JSON array of filenames
  createdAt    DateTime        @default(now())
  options      ProductOption[]
  orderItems   OrderItem[]
}

model ProductOption {
  id           Int      @id @default(autoincrement())
  productId    Int
  name         String
  price        Float?   // null = use product price
  available    Boolean? // null = use product availability
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([productId])
}

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int?
  customerName    String
  customerEmail   String
  customerPhone   String      @default("")
  billingAddress  String      @default("")
  shippingAddress String      @default("")
  status          String      @default("received") // "received" | "processing" | "shipped" | "finished"
  shipmentId      String      @default("")
  notes           String      @default("")
  total           Float       @default(0)
  stripeSessionId String      @default("")
  stripeInvoiceId String      @default("")
  stripeInvoiceUrl String     @default("")
  paymentMethod   String      @default("") // "card" | "mbway"
  createdAt       DateTime    @default(now())
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([stripeSessionId])
}

model OrderItem {
  id            Int            @id @default(autoincrement())
  orderId       Int
  productId     Int
  optionId      Int?
  productTitle  String
  optionName    String         @default("")
  quantity      Int            @default(1)
  unitPrice     Float
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  option        ProductOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderId])
}
