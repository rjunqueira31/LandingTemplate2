# Server
PORT=3002

# Database (each company gets its own DB)
DATABASE_URL="postgresql://user:password@localhost:5432/company_db"

# Session secret (generate a random string for production)
SESSION_SECRET=change-this-to-a-random-string

# Path to company data folder (absolute path or relative to project root)
# Leave empty to use default ./company/ folder (for local dev)
COMPANY_DATA_PATH=

# Stripe (optional — only if store is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
