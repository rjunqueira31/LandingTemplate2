# Server
PORT=3002

# Database (each company gets its own DB)
DATABASE_URL="postgresql://user:password@localhost:5432/company_db"

# Session secret (generate a random string for production)
SESSION_SECRET=change-this-to-a-random-string

# Admin bootstrap credentials — used ONLY by `node prisma/seed.js` to create the
# first admin user. Set a strong ADMIN_PASSWORD, run the seed once, then remove
# it: the DB stores only the bcrypt hash, so the plaintext is no longer needed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Path to company data folder (absolute path or relative to project root)
# Leave empty to use default ./company/ folder (for local dev)
COMPANY_DATA_PATH=

# Pages this deployment is entitled to (comma-separated allowlist).
# Controls which pages/features the client paid for. Only listed pages appear.
# Fail-closed: if unset or empty, NO pages are shown — you must opt in explicitly.
# Options: aboutUs,services,partners,contacts,gallery,bookings,vacations,store
ENABLED_PAGES=aboutUs,services,partners,contacts,gallery,vacations,store

# Stripe (optional — only if store is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
