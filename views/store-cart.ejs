<%- include('partials/head') %>
    <% if (company.pages.store) { %>
        <link rel="stylesheet" href="/public/css/store.css">
    <% } %>
    <%- include('partials/header') %>

    <main class="store-page cart-page">
        <div class="page-header">
            <p class="section-subtitle" data-i18n="store_your_cart">Your Cart</p>
            <h2 class="section-title" data-i18n="store_cart">Shopping Cart</h2>
        </div>

        <div id="cartContent">
            <div class="cart-items" id="cartItems">
                <!-- Cart items loaded via JS -->
            </div>

            <div class="cart-empty" id="cartEmpty" style="display:none;">
                <i class="fas fa-shopping-cart"></i>
                <p data-i18n="store_cart_empty">Your cart is empty.</p>
                <a href="/store" class="btn-continue" data-i18n="store_continue_shopping">Continue Shopping</a>
            </div>

            <div class="cart-summary" id="cartSummary" style="display:none;">
                <div class="cart-total">
                    <span data-i18n="store_total">Total:</span>
                    <span id="cartTotal">€0.00</span>
                </div>
                <a href="/store/checkout" class="btn-checkout" data-i18n="store_go_checkout">Proceed to Checkout</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/public/js/main.js"></script>
    <script src="/public/js/store.js"></script>
    <script>i18n.init();</script>
    </body>
</html>
